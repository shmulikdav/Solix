{
  "name": "@shmulikdav/solix",
  "version": "1.12.0",
  "description": "Solix — a solar-system command center for Claude Code agents",
  "license": "MIT",
  "type": "module",
  "bin": {
    "solix": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shmulikdav/Solix.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/shmulikdav/Solix#readme",
  "bugs": {
    "url": "https://github.com/shmulikdav/Solix/issues"
  },
  "keywords": [
    "claude-code",
    "claude",
    "agents",
    "orchestration",
    "cli",
    "anthropic"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup && node ./scripts/copy-static.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm -w -r build",
    "pack:dry": "pnpm -w -r build && npm pack --dry-run"
  },
  "dependencies": {
    "@hono/node-server": "^1.11.0",
    "better-sqlite3": "^11.0.0",
    "commander": "^12.0.0",
    "hono": "^4.4.0",
    "nanoid": "^5.1.11",
    "node-pty": "^1.1.0",
    "open": "^10.1.0",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@solix/server": "workspace:*",
    "@solix/shared": "workspace:*",
    "@types/better-sqlite3": "^7.6.10",
    "@types/node": "^20.12.0",
    "@types/ws": "^8.5.10",
    "tsup": "^8.0.0",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
